MONGODB_URI=mongodb://localhost:27017/investoros
JWT_SECRET=your_super_secret_jwt_key_here
PORT=5000
FRONTEND_URL=http://localhost:5173

# Email (optional) — needed for "Send Email" feature on documents
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_gmail@gmail.com
SMTP_PASS=your_app_password
# Set to false only when a local proxy/antivirus replaces the SMTP certificate.
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Cloudinary property image uploads
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
